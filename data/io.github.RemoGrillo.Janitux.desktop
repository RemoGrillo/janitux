[Desktop Entry]
Type=Application
Name=Janitux
GenericName=Disk Usage Analyzer
GenericName[it]=Analizzatore dell'uso del disco
Comment=Investigate what fills your disk
Comment[it]=Indaga su cosa riempie il disco
Exec=janitux %f
Icon=io.github.RemoGrillo.Janitux
Terminal=false
Categories=GTK;System;Filesystem;
Keywords=disk;space;usage;storage;size;clean;cleaner;janitor;suspects;treemap;sunburst;
Keywords[it]=disco;spazio;occupazione;dimensioni;pulizia;bidello;sospettati;
StartupNotify=true
